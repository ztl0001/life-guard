# 默认按文本处理，自动识别二进制
* text=auto

# Windows 脚本必须保持 CRLF，否则 cmd.exe 解析 .cmd 会出问题
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf

# Python / 前端保持 LF
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.java text eol=lf
*.xml text eol=lf

# 二进制
*.apk binary
*.png binary
*.jpg binary
*.jpeg binary
*.keystore binary
